{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tri-code",
  "version": "../package.json",
  "identifier": "dev.tricode.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxOTlBRUE5RTcyMUFBRjQKUldUMHFpSG5xYTZaMGQ0eEhiWG83VnRZQWhOUUtVN0t0VlFyKzVTZDcrSDVueTdqdDU5RFZrOUsK",
      "endpoints": [
        "https://github.com/WaldoJoubert-GH/tri-code/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
