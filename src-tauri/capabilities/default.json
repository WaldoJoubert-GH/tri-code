{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the app UI webview only; browser panes get none",
  "permissions": [
    "core:default",
    "core:webview:default",
    "core:event:default",
    "opener:default",
    "notification:default",
    "updater:default",
    "process:allow-restart"
  ],
  "webviews": [
    "main"
  ]
}
